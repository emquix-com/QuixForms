{
  "name": "quixforms-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build -w @emquix/quixforms-core-plugin"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.1",
    "@emdash-cms/blocks": "1.3.1",
    "@emdash-cms/plugin-cli": "0.13.4",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.6"
  },
  "overrides": {
    "zod": "$zod"
  }
}
