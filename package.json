{
  "name": "quixforms-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run build:packages && vitest run",
    "build": "npm run build:packages && npm run typecheck && npm run build -w @emquix/quixforms-core-plugin",
    "test:browser": "npm run build:packages && playwright test",
    "build:packages": "node scripts/build-packages.mjs",
    "pack:candidate": "node scripts/pack-candidate.mjs",
    "kit:candidate": "npm run build && npm run pack:candidate && npm run bundle:candidate && node scripts/release-kit.mjs",
    "bundle:candidate": "node scripts/bundle-candidate.mjs"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.1",
    "@emdash-cms/blocks": "1.3.1",
    "@emdash-cms/plugin-cli": "0.13.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "astro": "7.4.2",
    "emdash": "1.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "tsdown": "0.20.3"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.6"
  },
  "overrides": {
    "zod": "$zod"
  }
}
