{
  "name": "@emquix/quixforms-engine",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "EmQuix",
    "url": "https://emquix.com"
  },
  "private": true,
  "exports": {
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./dist/schema.mjs"
    },
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./templates": {
      "types": "./src/templates.ts",
      "import": "./dist/templates.mjs"
    },
    "./submissions": {
      "types": "./src/submissions.ts",
      "import": "./dist/submissions.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emquix-com/QuixForms.git",
    "directory": "packages/core"
  },
  "dependencies": {
    "zod": "4.6.6"
  }
}
