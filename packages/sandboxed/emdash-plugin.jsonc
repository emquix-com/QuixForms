{
  "slug": "quixforms",
  "publisher": "did:plc:6clqzka76ueshbureaecbrfj",
  "name": "QuixForms",
  "license": "MIT",
  "author": {
    "name": "EmQuix",
    "url": "https://emquix.com",
  },
  "description": "Powerful Forms. Effortless Building.",
  "repo": "https://github.com/emquix-com/QuixForms",
  "keywords": ["forms", "contact", "notifications", "conditional-logic"],
  "sections": {
    "description": { "file": "./docs/registry/description.md" },
    "installation": { "file": "./docs/registry/installation.md" },
    "faq": { "file": "./docs/registry/faq.md" },
    "changelog": { "file": "./docs/registry/changelog.md" },
    "security": { "file": "./docs/registry/security.md" }
  },
  "capabilities": ["email:send", "network:request"],
  "allowedHosts": ["challenges.cloudflare.com"],
  "storage": {
    "forms": {
      "indexes": ["title"],
    },
    "entries": {
      "indexes": ["formId", "createdAt", "status", "starred", "reference", ["formId", "createdAt"], ["formId", "status", "createdAt"], ["formId", "starred", "createdAt"], ["formId", "reference"]],
    },
  },
  "admin": {
    "pages": [
      {
        "path": "/forms",
        "label": "QuixForms",
        "icon": "list",
      },
    ],
    "settingsSchema": {
      "turnstileSecret": {
        "type": "secret",
        "label": "Turnstile secret",
      },
      "turnstileSiteKey": {
        "type": "string",
        "label": "Turnstile site key",
      },
    },
  },
  "security": {
    "url": "https://github.com/emquix-com/QuixForms/security",
  },
  "release": {
    "requires": { "env:emdash": ">=1.3.1 <1.4.0" }
  }
}
